---
import type { Project } from '../lib/github';
import ProjectRow from './ProjectRow.astro';

interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
---

<section id="work">
  <div class="wrap">
    <div class="work__head">
      <span class="label accent">02 / Selected work</span>
      <h2 class="h2">What I<br />build.</h2>
      <p class="work__note mono">
        Pulled live from GitHub at build · {projects.length} entries
      </p>
    </div>

    <div class="work__list">
      {projects.map((p, i) => <ProjectRow project={p} index={i + 1} />)}
    </div>
  </div>
</section>

<style>
  .work__head {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'label note'
      'title title';
    gap: 0.75rem 2rem;
    align-items: end;
    margin-bottom: clamp(1rem, 4vw, 2rem);
  }
  .work__head .label { grid-area: label; }
  .work__head .h2 { grid-area: title; }
  .work__note {
    grid-area: note;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-60);
    text-align: right;
  }
  .work__list {
    border-bottom: var(--rule) solid var(--ink);
  }
  @media (max-width: 640px) {
    .work__head {
      grid-template-columns: 1fr;
      grid-template-areas: 'label' 'title' 'note';
    }
    .work__note { text-align: left; }
  }
</style>
